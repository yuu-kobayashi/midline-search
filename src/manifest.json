{
	"manifest_version": 3,
	"name": "Midline Search",
	"version": "1.0.0",
	"description": "Google検索結果ページのレイアウトを中央揃えに変更するChrome拡張機能です。",
	"permissions": ["storage", "activeTab", "tabs"],
	"action": {
		"default_popup": "popup/popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"content_scripts": [
		{
			"matches": ["https://www.google.com/search*", "https://www.google.co.jp/search*"],
			"js": ["content/content.js"],
			"run_at": "document_start"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["content/search-page.css"],
			"matches": ["https://www.google.com/*", "https://www.google.co.jp/*"]
		}
	],
	"icons": {
		"16": "icons/icon-16.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	}
}
